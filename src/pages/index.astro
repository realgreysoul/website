---
import Layout from "../layouts/Layout.astro";
import "../styles/index.css";
import Age from "../components/Age.astro";
import SocialsButtons from "../components/SocialsButtons.astro";
import ToastDialog from "../components/ToastDialog.astro";
import ProjectsGallery from "../components/ProjectsGallery.astro";
import DonateButtons from "../components/DonateButtons.astro";
---

<Layout
  title="Greysoul"
  description="Какой-то рандомный чел в интернете, который что-то делает"
>
  <div id="about" class="style1 container default">
    <div class="wrapper">
      <div class="inner">
        <h1 id="aboutHeading" class="style1">Коротко обо мне</h1>
        <p id="aboutText" class="style2">
          <span class="p">
            Имя - <strong>Александр</strong>, <strong>мужской пол</strong>, <Age
            />, родился <strong>27 сентября 2004 года</strong>, живу в <strong
              >России</strong
            >, а конкретно в <strong>Сибири</strong>.
          </span>
          <span class="p">
            Больше подробностей доступны на странице «<strong
              ><a href="/about/">Обо мне</a></strong
            >».
          </span>
        </p>
      </div>
    </div>
  </div>

  <div id="socials" class="style1 container default">
    <div class="wrapper">
      <div class="inner">
        <h1 id="socialsHeading" class="style1">Мои соц-сети и не только</h1>
        <SocialsButtons />
        <p id="socialsOthers" class="style2">
          Имя пользователя в остальных соц-сетях - <strong
            ><a
              data-toast-trigger="realgreysoul"
              aria-label="Копирование имени пользователя в буфер обмена"
              >@realgreysoul</a
            ></strong
          >
        </p>
        <p id="socialsEmail" class="style2">
          Электронная почта - <strong
            ><a href="mailto:contact@greysoul.ru">contact@greysoul.ru</a
            ></strong
          >
        </p>
      </div>
    </div>
  </div>

  <ToastDialog slot="overlay" />

  <div id="projects" class="style1 container default">
    <div class="wrapper">
      <div class="inner">
        <h1 id="projectsHeading" class="style1">Мои проекты</h1>
        <ProjectsGallery />
      </div>
    </div>
  </div>

  <div id="donate" class="style1 container default">
    <div class="wrapper">
      <div class="inner">
        <h1 id="donateHeading" class="style1">
          Донат <em><span style="color: #545454">(если хотите)</span></em>
        </h1>
        <DonateButtons />
      </div>
    </div>
  </div>
</Layout>
