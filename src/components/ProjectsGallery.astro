---
import { getImageUrlWithOptions, getProjectImages } from "../utils/contentful";

const project = await getProjectImages();
---

<div id="projectsGallery" class="style1 gallery">
  <div class="inner">
    <ul>
      {
        project.map(({ url, image, title, description, alt, crop }) => (
          <li>
            <a href={url} target="_blank" class="thumbnail">
              <span class="frame">
                <img src={getImageUrlWithOptions(image, { crop })} alt={alt} />
              </span>
            </a>
            <div class="caption">
              <p>
                <span style="color: #000000">
                  <strong>{title}</strong>
                </span>
                {" - "}
                {description}
              </p>
            </div>
          </li>
        ))
      }
    </ul>
  </div>
</div>
