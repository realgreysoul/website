<div
  id="gallery-modal"
  class="gallery-modal"
  tabindex="-1"
  aria-label="Просмотр изображения"
>
  <div class="inner">
    <img src="" alt="" />
  </div>

  <div class="caption"></div>

  <div
    class="nav previous"
    role="button"
    tabindex="0"
    aria-label="Предыдущее изображение"
  >
  </div>

  <div
    class="nav next"
    role="button"
    tabindex="0"
    aria-label="Следующее изображение"
  >
  </div>

  <div class="close" role="button" tabindex="0" aria-label="Закрыть"></div>
</div>

<script>
  type GalleryOptions = {
    id: string;
    navigation: boolean;
    captions: boolean;
    protect: boolean;
  };

  type TouchStart = {
    x: number;
  };

  class LightboxGallery {
    private readonly modal: HTMLElement;
    private readonly modalInner: HTMLElement;
    private readonly modalImage: HTMLImageElement;
    private readonly modalCaption: HTMLElement;
    private readonly modalNext: HTMLElement;
    private readonly modalPrevious: HTMLElement;
    private readonly delay = 375;

    private links: NodeListOf<HTMLAnchorElement> | null = null;
    private locked = false;
    private current: number | null = null;
    private navigation = false;
    private captions = false;
    private protect = false;
    private dragStart: TouchStart | null = null;

    constructor(modal: HTMLElement) {
      const modalInner = modal.querySelector<HTMLElement>(".inner");
      const modalImage = modal.querySelector<HTMLImageElement>("img");
      const modalCaption = modal.querySelector<HTMLElement>(".caption");
      const modalNext = modal.querySelector<HTMLElement>(".next");
      const modalPrevious = modal.querySelector<HTMLElement>(".previous");

      if (
        !modalInner ||
        !modalImage ||
        !modalCaption ||
        !modalNext ||
        !modalPrevious
      ) {
        throw new Error("Некорректная структура Lightbox");
      }

      this.modal = modal;
      this.modalInner = modalInner;
      this.modalImage = modalImage;
      this.modalCaption = modalCaption;
      this.modalNext = modalNext;
      this.modalPrevious = modalPrevious;

      this.bindEvents();
    }

    init({ id, navigation, captions, protect }: GalleryOptions): void {
      const links = document.querySelectorAll<HTMLAnchorElement>(
        `#${id} .thumbnail`,
      );

      if (!links.length) return;

      const validCount = [...links].filter(
        (link) => link.dataset.lightboxIgnore !== "1",
      ).length;

      this.links = links;
      this.navigation = navigation && validCount >= 2;
      this.captions = captions;
      this.protect = protect;

      links.forEach((link, index) => {
        if (link.dataset.lightboxIgnore === "1") return;

        link.addEventListener("click", (event) => {
          event.preventDefault();
          event.stopPropagation();

          this.show(index);
        });
      });
    }

    private bindEvents(): void {
      this.modalImage.addEventListener("load", () => {
        this.modalImage.style.setProperty(
          "--natural-width",
          `${this.modalImage.naturalWidth}px`,
        );

        this.modalImage.style.setProperty(
          "--natural-height",
          `${this.modalImage.naturalHeight}px`,
        );

        this.modal.classList.add("done");

        window.setTimeout(
          () => {
            if (!this.modal.classList.contains("visible")) return;

            this.modal.classList.add("loaded");

            window.setTimeout(() => {
              this.modal.classList.remove(
                "switching",
                "from-left",
                "from-right",
                "done",
              );
            }, this.delay);
          },
          this.modal.classList.contains("switching") ? 0 : this.delay,
        );
      });

      this.modal.addEventListener("click", (event) => {
        if (!(event.target instanceof Element)) return;

        if (!event.target.closest(".inner")) {
          this.hide();
        }
      });

      this.modal.addEventListener("keydown", (event) => {
        if (!this.modal.classList.contains("visible")) return;

        switch (event.key) {
          case "ArrowRight":
          case " ":
            if (!this.navigation) return;

            event.preventDefault();
            this.next();
            break;

          case "ArrowLeft":
            if (!this.navigation) return;

            event.preventDefault();
            this.previous();
            break;

          case "Escape":
            event.preventDefault();
            this.hide();
            break;
        }
      });

      this.modalNext.addEventListener("click", (event) => {
        event.stopPropagation();
        this.next();
      });

      this.modalPrevious.addEventListener("click", (event) => {
        event.stopPropagation();
        this.previous();
      });

      this.modalInner.addEventListener("touchstart", (event) => {
        if (!this.navigation || event.touches.length > 1) return;

        this.dragStart = {
          x: event.touches[0].clientX,
        };
      });

      this.modalInner.addEventListener(
        "touchmove",
        (event) => {
          if (!this.navigation || !this.dragStart || event.touches.length > 1) {
            return;
          }

          const dx = this.dragStart.x - event.touches[0].clientX;

          if (Math.abs(dx) < 50) return;

          event.preventDefault();

          if (dx > 0) {
            this.next(-1);
          } else {
            this.previous(1);
          }
        },
        { passive: false },
      );

      this.modalInner.addEventListener("touchend", () => {
        this.dragStart = null;
      });

      const handleControlKey = (event: KeyboardEvent): void => {
        if (event.key !== "Enter" && event.key !== " ") return;

        event.preventDefault();

        const target = event.currentTarget;

        if (target === this.modalNext) {
          this.next();
        } else if (target === this.modalPrevious) {
          this.previous();
        } else {
          this.hide();
        }
      };

      this.modalNext.addEventListener("keydown", handleControlKey);
      this.modalPrevious.addEventListener("keydown", handleControlKey);

      const close = this.modal.querySelector<HTMLElement>(".close");

      close?.addEventListener("click", (event) => {
        event.stopPropagation();
        this.hide();
      });

      close?.addEventListener("keydown", handleControlKey);

      if (this.protect) {
        this.applyProtection();
      }
    }

    private applyProtection(): void {
      this.modalImage.addEventListener(
        "contextmenu",
        (event) => event.preventDefault(),
        true,
      );

      this.modalImage.addEventListener(
        "dragstart",
        (event) => event.preventDefault(),
        true,
      );
    }

    private show(index: number): void {
      if (this.locked || !this.links) return;

      const item = this.getItem(index);

      if (!item) return;

      this.locked = true;

      this.modalNext.style.display = this.navigation ? "" : "none";
      this.modalPrevious.style.display = this.navigation ? "" : "none";
      this.modalCaption.style.display = this.captions ? "" : "none";

      this.updateProtection();

      if (this.current !== null) {
        this.modal.classList.remove("loaded");
        this.modal.classList.add("switching");

        this.modalImage.src = item.href;
        this.updateCaption(item);

        window.setTimeout(() => {
          this.current = index;
          this.modal.classList.remove("from-left", "from-right");

          window.setTimeout(() => {
            this.modal.focus();
            this.locked = false;
          }, this.delay);
        }, this.delay);

        return;
      }

      this.current = index;
      this.modalImage.src = item.href;
      this.updateCaption(item);

      this.modal.classList.add("visible");

      window.setTimeout(() => {
        this.modal.focus();
        this.locked = false;
      }, this.delay);
    }

    private getItem(index: number): HTMLAnchorElement | null {
      if (!this.links || this.links.length === 0) return null;

      let normalizedIndex = index;

      if (normalizedIndex < 0) {
        normalizedIndex = this.links.length - 1;
      } else if (normalizedIndex >= this.links.length) {
        normalizedIndex = 0;
      }

      const item = this.links[normalizedIndex];

      if (!item || item.dataset.lightboxIgnore === "1") {
        return null;
      }

      return item;
    }

    private getRelativeIndex(offset: number): number | null {
      if (!this.links || this.current === null) return null;

      let index = this.current;

      for (let i = 0; i < this.links.length; i++) {
        index += offset;

        if (index < 0) {
          index = this.links.length - 1;
        } else if (index >= this.links.length) {
          index = 0;
        }

        if (index === this.current) {
          return null;
        }

        const item = this.links[index];

        if (item && item.dataset.lightboxIgnore !== "1") {
          return index;
        }
      }

      return null;
    }

    private next(direction?: number): void {
      const index =
        direction === undefined
          ? this.getRelativeIndex(1)
          : this.getRelativeIndex(1);

      if (index === null) return;

      this.showWithDirection(index, direction);
    }

    private previous(direction?: number): void {
      const index =
        direction === undefined
          ? this.getRelativeIndex(-1)
          : this.getRelativeIndex(-1);

      if (index === null) return;

      this.showWithDirection(index, direction);
    }

    private showWithDirection(index: number, direction?: number): void {
      if (this.locked || !this.links || this.current === null) return;

      const item = this.getItem(index);

      if (!item) return;

      this.locked = true;

      this.modal.classList.remove("loaded");
      this.modal.classList.add("switching");

      if (direction === -1) {
        this.modal.classList.add("from-left");
      } else if (direction === 1) {
        this.modal.classList.add("from-right");
      }

      window.setTimeout(() => {
        this.current = index;
        this.modalImage.src = item.href;
        this.updateCaption(item);

        window.setTimeout(() => {
          this.modal.focus();
          this.locked = false;
        }, this.delay);
      }, this.delay);
    }

    private updateCaption(item: HTMLAnchorElement): void {
      if (!this.captions) return;

      const caption = item.querySelector<HTMLElement>("[data-caption]");

      this.modalCaption.innerHTML = caption?.dataset.caption ?? "";
    }

    private updateProtection(): void {
      this.modalImage.style.setProperty(
        "-webkit-touch-callout",
        this.protect ? "none" : "",
      );
      this.modalImage.style.userSelect = this.protect ? "none" : "";
    }

    private hide(): void {
      if (this.locked || !this.modal.classList.contains("visible")) {
        return;
      }

      this.locked = true;

      this.modal.classList.remove(
        "visible",
        "loaded",
        "switching",
        "from-left",
        "from-right",
        "done",
      );

      window.setTimeout(() => {
        this.modalImage.src = "";
        this.locked = false;
        this.current = null;
        document.body.focus();
      }, this.delay);
    }
  }

  const modal = document.getElementById("gallery-modal");

  if (modal) {
    const gallery = new LightboxGallery(modal);

    gallery.init({
      id: "fursonaGallery",
      navigation: true,
      captions: true,
      protect: false,
    });
  }
</script>
