<script>
  interface InitConfig {
    id: string;
    navigation: boolean;
    captions: boolean;
    protect?: boolean;
  }

  interface ShowConfig {
    $links: NodeListOf<HTMLAnchorElement>;
    navigation: boolean;
    captions: boolean;
    protect: boolean;
  }

  interface GalleryModal extends HTMLDivElement {
    show: (index?: number | null, offset?: number, direction?: number) => void;
    hide: () => void;
    next: (direction?: number) => void;
    previous: (direction?: number) => void;
  }

  class LightboxGallery {
    $modal!: GalleryModal;
    $modalImage!: HTMLImageElement;
    $modalCaption!: HTMLDivElement;
    $modalNext!: HTMLDivElement;
    $modalPrevious!: HTMLDivElement;
    $links: NodeListOf<HTMLAnchorElement> | null = null;
    locked = false;
    current: number | null = null;
    delay = 375;
    navigation = false;
    captions = false;
    protect = false;
    dragStart: { x: number } | null = null;

    constructor() {
      this.initModal();
    }

    init(config: InitConfig) {
      const $links = document.querySelectorAll<HTMLAnchorElement>(
        "#" + config.id + " .thumbnail",
      );
      let navigation = config.navigation;

      let validCount = 0;
      for (let i = 0; i < $links.length; i++) {
        if ($links[i].dataset.lightboxIgnore !== "1") validCount++;
      }
      if (validCount < 2) navigation = false;

      for (let i = 0; i < $links.length; i++) {
        if ($links[i].dataset.lightboxIgnore === "1") continue;
        $links[i].addEventListener("click", (event) => {
          event.stopPropagation();
          event.preventDefault();
          this.show(i, {
            $links,
            navigation,
            captions: config.captions,
            protect: config.protect || false,
          });
        });
      }
    }

    private initModal() {
      const $modal = document.createElement("div") as GalleryModal;
      $modal.id = "gallery-modal";
      $modal.tabIndex = -1;
      $modal.className = "gallery-modal";
      $modal.innerHTML =
        '<div class="inner"><img src="" alt="Просмотр изображения" /></div>' +
        '<div class="caption"></div>' +
        '<div class="nav previous"></div>' +
        '<div class="nav next"></div>' +
        '<div class="close"></div>';

      document.body.appendChild($modal);

      const $modalInner = $modal.querySelector<HTMLDivElement>(".inner")!;
      const $modalImage = $modal.querySelector<HTMLImageElement>("img")!;
      const $modalCaption = $modal.querySelector<HTMLDivElement>(".caption")!;
      const $modalNext = $modal.querySelector<HTMLDivElement>(".next")!;
      const $modalPrevious = $modal.querySelector<HTMLDivElement>(".previous")!;

      $modalImage.addEventListener("load", () => {
        $modalImage.style.setProperty(
          "--natural-width",
          $modalImage.naturalWidth + "px",
        );
        $modalImage.style.setProperty(
          "--natural-height",
          $modalImage.naturalHeight + "px",
        );
        $modal.classList.add("done");

        setTimeout(
          () => {
            if (!$modal.classList.contains("visible")) return;
            $modal.classList.add("loaded");
            setTimeout(() => {
              $modal.classList.remove(
                "switching",
                "from-left",
                "from-right",
                "done",
              );
            }, this.delay);
          },
          $modal.classList.contains("switching") ? 0 : this.delay,
        );
      });

      if (this.protect) {
        $modalImage.addEventListener(
          "contextmenu",
          (e) => e.preventDefault(),
          true,
        );
        $modalImage.addEventListener(
          "dragstart",
          (e) => e.preventDefault(),
          true,
        );
      }

      $modal.show = (index, offset, direction) => {
        if (this.locked) return;
        const links = this.$links;
        if (!links) return;

        let i = typeof index === "number" ? index : (this.current ?? 0);
        let item: HTMLAnchorElement | undefined;

        if (typeof offset === "number") {
          let found = false;
          for (let j = 0; j < links.length; j++) {
            i += offset;
            if (i < 0) i = links.length - 1;
            else if (i >= links.length) i = 0;
            if (i === this.current) break;

            item = links[i];
            if (!item) break;
            if (item.dataset.lightboxIgnore !== "1") {
              found = true;
              break;
            }
          }
          if (!found) return;
        } else {
          if (i < 0) i = links.length - 1;
          else if (i >= links.length) i = 0;
          if (i === this.current) return;

          item = links[i];
          if (!item || item.dataset.lightboxIgnore === "1") return;
        }

        if (!item) return;
        const finalItem = item;
        const finalIndex = i;

        this.locked = true;

        const applyChange = () => {
          this.current = finalIndex;
          $modalImage.src = finalItem.href;
          if (this.captions) {
            const captionEl =
              finalItem.querySelector<HTMLElement>("[data-caption]");
            $modalCaption.innerHTML = captionEl?.dataset.caption ?? "";
          }
        };

        if (this.current !== null) {
          $modal.classList.remove("loaded");
          $modal.classList.add("switching");
          if (direction === -1) $modal.classList.add("from-left");
          else if (direction === 1) $modal.classList.add("from-right");

          setTimeout(() => {
            applyChange();
            setTimeout(() => {
              $modal.focus();
              this.locked = false;
            }, this.delay);
          }, this.delay);
        } else {
          applyChange();
          $modal.classList.add("visible");
          setTimeout(() => {
            $modal.focus();
            this.locked = false;
          }, this.delay);
        }
      };

      $modal.hide = () => {
        if (this.locked || !$modal.classList.contains("visible")) return;
        this.locked = true;
        $modal.classList.remove(
          "visible",
          "loaded",
          "switching",
          "from-left",
          "from-right",
          "done",
        );
        setTimeout(() => {
          $modalImage.src = "";
          this.locked = false;
          document.body.focus();
          this.current = null;
        }, this.delay);
      };

      $modal.next = (direction) => $modal.show(null, 1, direction);
      $modal.previous = (direction) => $modal.show(null, -1, direction);

      $modal.addEventListener("click", (e) => {
        if (!(e.target as HTMLElement).closest(".inner")) $modal.hide();
      });

      $modal.addEventListener("keydown", (e) => {
        if (!$modal.classList.contains("visible")) return;
        switch (e.key) {
          case "ArrowRight":
          case " ":
            if (!this.navigation) break;
            e.preventDefault();
            $modal.next();
            break;
          case "ArrowLeft":
            if (!this.navigation) break;
            e.preventDefault();
            $modal.previous();
            break;
          case "Escape":
            e.preventDefault();
            $modal.hide();
            break;
        }
      });

      $modalNext.addEventListener("click", (e) => {
        e.stopPropagation();
        $modal.next();
      });

      $modalPrevious.addEventListener("click", (e) => {
        e.stopPropagation();
        $modal.previous();
      });

      $modalInner.addEventListener("touchstart", (e) => {
        if (!this.navigation || e.touches.length > 1) return;
        this.dragStart = { x: e.touches[0].clientX };
      });

      $modalInner.addEventListener("touchmove", (e) => {
        if (!this.navigation || !this.dragStart || e.touches.length > 1) return;
        const dx = this.dragStart.x - e.touches[0].clientX;
        if (Math.abs(dx) < 50) return;
        e.preventDefault();
        if (dx > 0) $modal.next(-1);
        else $modal.previous(1);
      });

      $modalInner.addEventListener("touchend", () => {
        this.dragStart = null;
      });

      this.$modal = $modal;
      this.$modalImage = $modalImage;
      this.$modalCaption = $modalCaption;
      this.$modalNext = $modalNext;
      this.$modalPrevious = $modalPrevious;
    }

    private show(index: number, config: ShowConfig) {
      this.$links = config.$links;
      this.navigation = config.navigation;
      this.captions = config.captions;
      this.protect = config.protect;

      this.$modalNext.style.display = this.navigation ? "" : "none";
      this.$modalPrevious.style.display = this.navigation ? "" : "none";
      this.$modalCaption.style.display = this.captions ? "" : "none";

      if (this.protect) {
        this.$modalImage.style.setProperty("-webkit-touch-callout", "none");
        this.$modalImage.style.userSelect = "none";
      } else {
        this.$modalImage.style.removeProperty("-webkit-touch-callout");
        this.$modalImage.style.userSelect = "";
      }

      this.$modal.show(index);
    }
  }

  if (document.getElementById("fursonaGallery")) {
    const gallery = new LightboxGallery();
    gallery.init({
      id: "fursonaGallery",
      navigation: true,
      captions: true,
      protect: false,
    });
  }
</script>
