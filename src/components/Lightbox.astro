<script>
  class LightboxGallery {
    private modal: HTMLDivElement;
    private modalImage: HTMLImageElement;
    private modalCaption: HTMLDivElement;
    private modalNext: HTMLDivElement;
    private modalPrevious: HTMLDivElement;
    private links: NodeListOf<HTMLAnchorElement> = document.querySelectorAll(
      "#fursonaGallery .thumbnail",
    );
    private locked = false;
    private current: number | null = null;
    private delay = 375;
    private navigation = false;
    private captions = false;
    private protect = false;
    private dragStart: { x: number } | null = null;

    constructor() {
      const modal = document.createElement("div");
      modal.id = "gallery-modal";
      modal.tabIndex = -1;
      modal.className = "gallery-modal";
      modal.innerHTML =
        '<div class="inner"><img src="" alt="Просмотр изображения" /></div>' +
        '<div class="caption"></div>' +
        '<div class="nav previous"></div>' +
        '<div class="nav next"></div>' +
        '<div class="close"></div>';
      document.body.appendChild(modal);

      const modalImage = modal.querySelector<HTMLImageElement>("img");
      const modalCaption = modal.querySelector<HTMLDivElement>(".caption");
      const modalNext = modal.querySelector<HTMLDivElement>(".next");
      const modalPrevious = modal.querySelector<HTMLDivElement>(".previous");
      const modalInner = modal.querySelector<HTMLDivElement>(".inner");

      if (
        !modalImage ||
        !modalCaption ||
        !modalNext ||
        !modalPrevious ||
        !modalInner
      ) {
        throw new Error("Lightbox markup is incomplete");
      }

      this.modal = modal;
      this.modalImage = modalImage;
      this.modalCaption = modalCaption;
      this.modalNext = modalNext;
      this.modalPrevious = modalPrevious;

      modalImage.addEventListener("load", () => {
        modalImage.style.setProperty(
          "--natural-width",
          `${modalImage.naturalWidth}px`,
        );
        modalImage.style.setProperty(
          "--natural-height",
          `${modalImage.naturalHeight}px`,
        );
        modal.classList.add("done");

        setTimeout(
          () => {
            if (!modal.classList.contains("visible")) return;
            modal.classList.add("loaded");
            setTimeout(() => {
              modal.classList.remove(
                "switching",
                "from-left",
                "from-right",
                "done",
              );
            }, this.delay);
          },
          modal.classList.contains("switching") ? 0 : this.delay,
        );
      });

      modal.addEventListener("click", (event) => {
        const target = event.target;
        if (target instanceof Element && !target.closest(".inner")) {
          this.hide();
        }
      });

      modal.addEventListener("keydown", (event) => {
        if (!modal.classList.contains("visible")) return;
        switch (event.key) {
          case "ArrowRight":
          case " ":
            if (!this.navigation) return;
            event.preventDefault();
            this.next();
            break;
          case "ArrowLeft":
            if (!this.navigation) return;
            event.preventDefault();
            this.previous();
            break;
          case "Escape":
            event.preventDefault();
            this.hide();
            break;
        }
      });

      modalNext.addEventListener("click", (event) => {
        event.stopPropagation();
        this.next();
      });
      modalPrevious.addEventListener("click", (event) => {
        event.stopPropagation();
        this.previous();
      });

      modalInner.addEventListener("touchstart", (event) => {
        if (!this.navigation || event.touches.length > 1) return;
        this.dragStart = { x: event.touches[0].clientX };
      });
      modalInner.addEventListener("touchmove", (event) => {
        if (!this.navigation || !this.dragStart || event.touches.length > 1)
          return;
        const dx = this.dragStart.x - event.touches[0].clientX;
        if (Math.abs(dx) < 50) return;
        event.preventDefault();
        if (dx > 0) this.next(-1);
        else this.previous(1);
      });
      modalInner.addEventListener("touchend", () => {
        this.dragStart = null;
      });
    }

    init(config: { navigation: boolean; captions: boolean; protect: boolean }) {
      const validLinks = [...this.links].filter(
        (link) => link.dataset.lightboxIgnore !== "1",
      );
      this.navigation = config.navigation && validLinks.length >= 2;

      this.links.forEach((link, index) => {
        if (link.dataset.lightboxIgnore === "1") return;
        link.addEventListener("click", (event) => {
          event.stopPropagation();
          event.preventDefault();
          this.show(index, config.captions, config.protect);
        });
      });
    }

    private updateCaption(link: HTMLAnchorElement) {
      const caption = link.querySelector<HTMLElement>("[data-caption]");
      this.modalCaption.textContent = caption?.dataset.caption ?? "";
    }

    private show(
      index: number | null = this.current,
      captions = this.captions,
      protect = this.protect,
      offset?: number,
      direction?: number,
    ) {
      if (this.locked) return;
      const currentIndex = index ?? this.current;
      if (currentIndex === null) return;
      this.captions = captions;
      this.protect = protect;
      this.modalNext.style.display = this.navigation ? "" : "none";
      this.modalPrevious.style.display = this.navigation ? "" : "none";
      this.modalCaption.style.display = this.captions ? "" : "none";
      this.modalImage.style.setProperty(
        "-webkit-touch-callout",
        this.protect ? "none" : "",
      );
      this.modalImage.style.userSelect = this.protect ? "none" : "";

      let nextIndex = currentIndex;
      if (typeof offset === "number") {
        let found = false;
        for (let attempts = 0; attempts < this.links.length; attempts++) {
          nextIndex += offset;
          if (nextIndex < 0) nextIndex = this.links.length - 1;
          if (nextIndex >= this.links.length) nextIndex = 0;
          if (nextIndex === this.current) break;
          const link = this.links[nextIndex];
          if (link && link.dataset.lightboxIgnore !== "1") {
            found = true;
            break;
          }
        }
        if (!found) return;
      } else {
        if (nextIndex < 0) nextIndex = this.links.length - 1;
        if (nextIndex >= this.links.length) nextIndex = 0;
        const link = this.links[nextIndex];
        if (
          !link ||
          link.dataset.lightboxIgnore === "1" ||
          nextIndex === this.current
        )
          return;
      }

      const item = this.links[nextIndex];
      if (!item) return;
      this.locked = true;
      const update = () => {
        this.current = nextIndex;
        this.modalImage.src = item.href;
        if (this.captions) this.updateCaption(item);
        this.modal.focus();
        this.locked = false;
      };

      if (this.current !== null) {
        this.modal.classList.remove("loaded");
        this.modal.classList.add("switching");
        if (direction === -1) this.modal.classList.add("from-left");
        else if (direction === 1) this.modal.classList.add("from-right");
        setTimeout(update, this.delay);
      } else {
        update();
        this.modal.classList.add("visible");
      }
    }

    private hide() {
      if (this.locked || !this.modal.classList.contains("visible")) return;
      this.locked = true;
      this.modal.classList.remove(
        "visible",
        "loaded",
        "switching",
        "from-left",
        "from-right",
        "done",
      );
      setTimeout(() => {
        this.modalImage.src = "";
        this.locked = false;
        document.body.focus();
        this.current = null;
      }, this.delay);
    }

    private next(direction?: number) {
      this.show(null, this.captions, this.protect, 1, direction);
    }

    private previous(direction?: number) {
      this.show(null, this.captions, this.protect, -1, direction);
    }
  }

  if (document.getElementById("fursonaGallery")) {
    const gallery = new LightboxGallery();
    gallery.init({ navigation: true, captions: true, protect: false });
  }
</script>
