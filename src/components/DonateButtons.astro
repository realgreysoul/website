---
import { getDonates } from "../utils/contentful";

const donate = await getDonates();
---

<ul id="buttons02" class="style3 buttons">
  {
    donate.map(({ url, color, label }) => (
      <li>
        <a
          href={url}
          target="_blank"
          class="button"
          {...(color && { style: `background: ${color}` })}
        >
          {label}
        </a>
      </li>
    ))
  }
</ul>
